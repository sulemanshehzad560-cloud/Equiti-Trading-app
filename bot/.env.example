# Your Equiti MetaTrader 5 login (shown in the Equiti app / welcome email).
# Copy this file to .env - .env is git-ignored and never committed.
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-trading-password
# Exact server name as shown in MT5 > File > Login to Trade Account (e.g. the Equiti demo or live server)
MT5_SERVER=Equiti-Demo
# Optional: full path to terminal64.exe if you have more than one MT5 installed
MT5_TERMINAL_PATH=

# Access token for the Equiti Trader app (generated automatically on first run if left empty)
DASHBOARD_TOKEN=
# Optional: only allow the app hosted at this address to call the bot, e.g. https://equiti-trader.netlify.app
DASHBOARD_ORIGIN=
