      "NVDA": ["nvidia", "jensen huang"],
      "AMZN": ["amazon", "aws", "andy jassy"],
      "GOOGL": ["alphabet", "google", "youtube"],
      "META": ["meta platforms", "facebook", "instagram", "zuckerberg"]
