    "tsmom": { "enabled": true, "lookback": 252, "allow_short": false, "sl_atr": 4.0 },
    "xsmom": { "enabled": true, "top_n": 2, "lookback": 252, "skip": 21 },
    "tom":   { "enabled": false, "hold_days": 3 },
    "orb":   { "enabled": false, "or_minutes": 5, "stop_atr_frac": 0.1, "rel_vol_min": 1.0 },
    "imom":  { "enabled": false }
  },

  "risk": {
    "sizing": "allocation",
    "allocation_pct": 10,
    "risk_per_trade_pct": 0.5,
    "max_notional_pct": 25,
    "max_lots_per_trade": 100000,
    "max_open_positions": 8,
    "max_positions_per_symbol": 3,
    "max_daily_loss_pct": 3.0,
    "max_spread_points": 1000000,
    "max_spread_pct": 0.15,
    "sl_atr_mult": 3.0,
    "tp_atr_mult": 0,
