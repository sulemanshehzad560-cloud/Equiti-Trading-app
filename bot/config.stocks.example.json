{
  "symbols": ["US500", "US100", "AAPL", "MSFT", "NVDA", "AMZN", "GOOGL", "META"],
  "timeframe": "D1",
  "history_bars": 320,
  "poll_seconds": 30,
  "magic": 260927,
  "paper_balance": 10000,
  "journal": "logs/journal.jsonl",
